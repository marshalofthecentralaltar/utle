{
  "manifest_version": 3,
  "name": "Ütle",
  "version": "0.1.0",
  "description": "Lets the Ütle page move around the browser by voice and put a finished message into a site's message box.",
  "permissions": ["tabs", "scripting", "storage", "system.display"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Ütle beside this window" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
