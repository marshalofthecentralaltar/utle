{
  "manifest_version": 3,
  "name": "Ütle",
  "version": "0.2.0",
  "description": "Speak in Estonian: the words go into the message box of the page you are on, and the browser moves by voice.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Ütle: microphone on or off"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
