{
  "name": "utle",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run ext",
    "model": "tsx scripts/model.ts",
    "ext": "tsx scripts/ext.ts",
    "serve": "node --env-file-if-exists=.env.local --import tsx server/serve.ts",
    "ext:pack": "tsx scripts/pack.ts",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
